<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- docs/TODO.md T-49: permissions a dependency merges in that this app
         never exercises are removed here, so the shipped manifest lists what
         the app actually does and nothing more.

         RECORD_AUDIO arrives with camera_android_camerax, which flutter_zxing
         pulls for the QR scanner (docs/TODO.md T-33). The scanner creates its
         CameraController with `enableAudio: false`, so the microphone is never
         opened - but without this line an alarm clock would ask the user for
         microphone access, which is exactly the kind of permission nobody can
         explain later.

         WRITE_EXTERNAL_STORAGE (maxSdk 28) comes from the same camera plugin -
         an independent audit corrected an earlier note here that blamed
         image_picker, whose own manifest declares no permissions at all. The
         app writes nothing outside its own sandbox, and image_picker's gallery
         path (switched off, T-44) writes only to the cache directory, so even
         re-enabling it would not need this.

         READ_EXTERNAL_STORAGE comes from the `alarm` plugin itself, whose
         `AlarmSettings.assetAudioPath` doc comment asks for it to cover the
         case where that path points into shared/external storage. It never
         did here (this app's only local-file tone is a custom import, and
         that is deliberately copied into the app's own Documents directory -
         see `custom_tone.dart` - which every app can already read without
         any permission), and had no runtime request anywhere in the Dart
         code either. It sat unused since the very first commit; found and
         removed while adding that import feature.

         ACCESS_NETWORK_STATE comes from `media3-common` and Google's
         `transport-runtime`/`transport-backend-cct` libraries, pulled in
         transitively by `awesome_notifications` (media-style notification
         support and its own internal event-transport plumbing) - not
         declared by any Flutter plugin's own manifest, only found by
         grepping the merged native dependency tree. This app makes zero
         network calls anywhere in `lib/` (see `CLAUDE.md`'s first line);
         nothing here ever queries connectivity state, so there is nothing
         for those libraries' own network-awareness to do. Removing it also
         removes the one loose end left after `INTERNET` itself was already
         gone (T-33's ML Kit removal took that one with it) - an offline
         alarm clock declaring "can check network state" invited exactly
         the "why does it need this" question this file exists to answer. -->
    <!-- The QR gate is optional: a user who never sets a deactivation code
         never needs a camera. The camera plugin behind the scanner declares
         `android.hardware.camera.any` WITHOUT `android:required`, which
         defaults to true, and the CAMERA permission implies the feature as
         required as well - together that would let the Play Store hide an
         alarm clock from camera-less devices. The previous scanner declared it
         `required="false"`; this restores that. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"
        tools:replace="android:required" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:label="WakeyWakey"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <meta-data
                android:name="flutterEntrypoint"
                android:value="main" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- docs/TODO.md T-158: neither this app nor the `alarm` plugin is
             direct-boot-aware, so a reboot followed by the device staying
             locked withholds BOOT_COMPLETED (and with it, the plugin's own
             re-arm) entirely until the first unlock - the alarm does not
             ring at all until then. This is the Direct-Boot fallback:
             DirectBootReceiver gets LOCKED_BOOT_COMPLETED immediately
             (unlike BOOT_COMPLETED, which the OS withholds from
             non-direct-boot-aware apps the same way) and arms
             DirectBootFallbackAlarmReceiver for the instant
             lib/utils/direct_boot_mirror.dart last mirrored, which in turn
             starts DirectBootFallbackService - a real foreground service,
             not just a one-shot notification, because a BroadcastReceiver
             alone cannot loop a sound and vibration for long enough to
             actually wake anyone (found via real-device testing). None of
             these three can read the app's real alarm/settings data - see
             DirectBootFallback.kt's own doc comment for why. -->
        <receiver
            android:name=".DirectBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DirectBootFallbackAlarmReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />
        <service
            android:name=".DirectBootFallbackService"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="mediaPlayback" />

        <!-- docs/TODO.md T-165: the `alarm` plugin (5.12.0) declares its own
             AlarmReceiver as `android:exported="true"` with no
             `android:permission` and no `<intent-filter>` - reachable by ANY
             other installed app via an explicit broadcast naming this
             component. Its `ACTION_STOP` handler
             (AlarmService.handleStopAlarmCommand, called from
             AlarmReceiver.onReceive) fully silences a ringing alarm - audio,
             vibration, foreground service teardown - with NO check of any
             kind, completely bypassing this app's QR-scan "guaranteed
             wake-up" gate, which lives entirely in the Dart layer and is
             never consulted by this native receiver. The plugin's own
             ACTION_SNOOZE branch (SnoozeCoordinator.snooze) has a guard
             specifically because its authors know this receiver is exported
             to the world; no equivalent guard exists for ACTION_STOP.

             This override closes it the same way the camera <uses-feature>
             entries above already override a merged plugin manifest
             attribute (`tools:replace`). Confirmed safe: this app never
             configures a `stopButton`/`snoozeButton` on its own
             NotificationSettings (see
             lib/models/alarms/ringing_alarm_settings.dart's own doc
             comment), so the plugin's notification-building code
             (NotificationService.kt) never actually attaches a
             Stop/Snooze-action PendingIntent to any notification this app
             ships - there is nothing of that kind for another app to
             extract via NotificationListenerService and re-fire (the
             mechanism https://developer.android.com/privacy-and-security/
             risks/sender-of-pending-intents documents, and the one
             android:exported="false" genuinely does NOT block - a
             PendingIntent, once handed to another process, still resolves
             regardless of the target's export status). What exported=false
             DOES block is the plain, zero-precondition path this app is
             actually exposed to: a foreign app constructing its own
             explicit Intent naming this component directly and calling
             `sendBroadcast()` - which needs no notification access, no
             PendingIntent, nothing but the component's public,
             open-source class name. AlarmManager's own delivery of the
             app's scheduled alarms, and the app's own Dart-side
             `Alarm.stop()`/`Alarm.snooze()` calls, are both unaffected:
             neither goes through a foreign app's own `sendBroadcast()` -
             see docs/security-assessment-2026-09.md's Finding F1 for the
             full writeup, including how this specific configuration detail
             was verified against the plugin's own source rather than
             assumed. -->
        <receiver
            android:name="com.gdelataillade.alarm.alarm.AlarmReceiver"
            android:exported="false"
            tools:replace="android:exported" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility?hl=en and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
